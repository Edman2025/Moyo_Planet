{
  "name": "moyo-planet",
  "private": true,
  "version": "0.0.0",
  "description": "An open-source mobile social pet and life simulation game.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edman2025/Moyo_Planet.git"
  },
  "bugs": {
    "url": "https://github.com/Edman2025/Moyo_Planet/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node scripts/check-production.mjs && node server/index.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:docker-context": "node scripts/verify-docker-context.mjs",
    "verify:docker-build": "node scripts/verify-docker-build.mjs",
    "verify:docker-runtime": "node scripts/verify-docker-runtime.mjs",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:dependencies": "node scripts/verify-dependencies.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:clean-data": "node scripts/verify-clean-data.mjs",
    "audit:readiness": "node scripts/audit-readiness.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:full": "node scripts/release-full.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
